# =============================================================================
# Multi-Agent Orchestrator Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Override per-agent with MA_ROUTER_*, MA_DS_*, MA_IT_* env vars.

# --- OpenRouter API Key ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Router (Gemini via OpenRouter) ---
MA_ROUTER_BASE_URL=https://openrouter.ai/api/v1
MA_ROUTER_MODEL=google/gemini-3-flash-preview

# --- Data Scientist Agent ---
MA_DS_BASE_URL=https://openrouter.ai/api/v1
MA_DS_MODEL=google/gemini-3-flash-preview

# --- IT Infrastructure Agent ---
MA_IT_BASE_URL=https://openrouter.ai/api/v1
MA_IT_MODEL=google/gemini-3-flash-preview

# --- Agent Names ---
MA_DS_NAME=Sarah
MA_IT_NAME=Mike

# --- TTS Voice Mapping (must match voices on TTS server) ---
MA_DS_VOICE=qwen3-data-scientist-demo-en-en
MA_IT_VOICE=qwen3-male-it-expert-en
