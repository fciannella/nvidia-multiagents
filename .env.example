# =============================================================================
# Magpie TTS Spark — Environment Variables
# =============================================================================
# Copy to .env and fill in your values.
# Docker Compose reads this file automatically via env_file.

# ── STT (all pipelines) ──────────────────────────────────────────────
ASSEMBLYAI_API_KEY=your-assemblyai-key
ASSEMBLYAI_LANGUAGE=multi

# ── TTS servers ──────────────────────────────────────────────────────
# Magpie (Pipeline 1)
MAGPIE_TTS_SERVER=192.168.7.203:9000

# Qwen3 (Pipelines 2 & 3)
TTS_SERVER=http://192.168.7.163:8100

# ── Router + Agent LLMs (Pipelines 1 & 2, multi-agent) ──────────────
# These are also in multiagent/.env — root .env takes precedence in Docker.
OPENROUTER_API_KEY=sk-or-v1-your-key
MA_ROUTER_BASE_URL=https://openrouter.ai/api/v1
MA_ROUTER_MODEL=google/gemini-3-flash-preview
MA_AGENT_BASE_URL=https://openrouter.ai/api/v1
MA_AGENT_MODEL=google/gemini-3-flash-preview

# ── ReAct Agent LLMs (Pipeline 3, single-agent) ─────────────────────
FRONT_AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
FRONT_AGENT_LLM_MODEL=google/gemini-3-flash-preview
EXECUTOR_LLM_BASE_URL=https://openrouter.ai/api/v1
EXECUTOR_LLM_MODEL=google/gemini-3-flash-preview
FILLER_LLM_BASE_URL=https://openrouter.ai/api/v1
FILLER_LLM_MODEL=google/gemini-3-flash-preview
